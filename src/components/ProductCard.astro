---
import siteConfig from '../../site.config';
import ProductImage from './ProductImage.astro';
import type { Product } from '../lib/products';
import { getCategoryLabel, formatPrice, STATUS_LABEL } from '../lib/products';

interface Props {
  product: Product;
  /** 첫 화면에 보이는 카드는 eager 로딩으로 LCP 개선 */
  eager?: boolean;
  /** 프리셋을 무시하고 특정 구조를 강제할 때만 사용 (관련 제품 등) */
  variant?: 'card' | 'overlay' | 'list';
}

const { product, eager = false, variant } = Astro.props;
const shape = variant ?? siteConfig.layout.productCard;

const { data } = product;
const statusLabel = STATUS_LABEL[data.status];

// 구조에 따라 필요한 이미지 폭이 다릅니다.
const widths = shape === 'list' ? [240, 360, 480] : [320, 480, 640];
const sizes =
  shape === 'list'
    ? '(max-width: 640px) 35vw, 200px'
    : '(max-width: 640px) 50vw, 300px';
---

<article class="card" data-shape={shape}>
  <a href={`/products/${product.id}/`} class="card__link">
    <div class="card__media">
      <ProductImage
        image={data.thumbnail}
        alt={data.title}
        widths={widths}
        sizes={sizes}
        loading={eager ? 'eager' : 'lazy'}
        class="card__img"
      />
      {statusLabel && <span class="card__status">{statusLabel}</span>}
    </div>

    <div class="card__body">
      <span class="card__cat">{getCategoryLabel(data.category)}</span>
      <h3 class="card__title">{data.title}</h3>
      <p class="card__summary">{data.summary}</p>
      <p class="card__price">{formatPrice(data.price, data.priceNote)}</p>
    </div>
  </a>
</article>

<style>
  .card {
    background: var(--color-bg);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: box-shadow var(--dur) var(--ease), transform var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }

  .card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .card__media {
    position: relative;
    background: var(--color-bg-muted);
    overflow: hidden;
  }

  /**
   * :global 이 필요한 이유 —
   * class를 자식 컴포넌트(ProductImage)에 prop으로 넘기면 Astro의 scoped 해시가
   * 붙지 않아 일반 선택자로는 매칭되지 않습니다. 그러면 이미지가 media 박스를
   * 채우지 않고 원본 비율대로 남아 overlay/list 구조가 깨집니다.
   * media가 비율을 정하고 이미지는 그 안을 채우도록 절대 배치합니다.
   */
  .card__media :global(.card__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card__status {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    background: var(--color-text);
    color: var(--color-bg);
    font-size: var(--text-xs);
    font-weight: 600;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
  }

  .card__cat {
    font-size: var(--text-xs);
    color: var(--color-accent);
    font-weight: 600;
  }

  .card__title {
    font-size: var(--text-base);
    margin: 0;
  }

  .card__summary {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card__price {
    margin: var(--space-2) 0 0;
    font-size: var(--text-sm);
    font-weight: 600;
  }

  /* ---------- card : 테두리 + 4:3 이미지 + 아래 텍스트 ---------- */

  .card[data-shape='card'] {
    border: 1px solid var(--color-border);
  }

  .card[data-shape='card'] .card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .card[data-shape='card'] .card__media {
    aspect-ratio: 4 / 3;
  }

  .card[data-shape='card'] .card__body {
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    flex: 1;
  }

  /* ---------- overlay : 이미지 위에 텍스트 ---------- */

  .card[data-shape='overlay'] .card__link {
    display: block;
    position: relative;
  }

  .card[data-shape='overlay'] .card__media {
    aspect-ratio: 3 / 4;
  }

  .card[data-shape='overlay'] .card__body {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    padding: var(--space-6) var(--space-4) var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    /* 이미지가 밝아도 글자가 읽히도록 아래쪽에 그라데이션을 깝니다 */
    background: linear-gradient(
      180deg,
      transparent 0%,
      rgba(0, 0, 0, 0.35) 40%,
      rgba(0, 0, 0, 0.78) 100%
    );
    color: #fff;
  }

  .card[data-shape='overlay'] .card__cat {
    color: #fff;
    opacity: 0.85;
  }

  .card[data-shape='overlay'] .card__summary {
    color: rgba(255, 255, 255, 0.82);
    -webkit-line-clamp: 1;
    line-clamp: 1;
  }

  .card[data-shape='overlay'] .card__price {
    color: #fff;
  }

  /* ---------- list : 좌측 이미지 + 우측 텍스트 ---------- */

  .card[data-shape='list'] {
    border: 1px solid var(--color-border);
  }

  .card[data-shape='list'] .card__link {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: var(--space-5, var(--space-4));
    align-items: stretch;
  }

  .card[data-shape='list'] .card__media {
    aspect-ratio: 1 / 1;
  }

  .card[data-shape='list'] .card__body {
    padding: var(--space-4) var(--space-4) var(--space-4) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    justify-content: center;
  }

  .card[data-shape='list'] .card__title {
    font-size: var(--text-lg);
  }

  .card[data-shape='list'] .card__summary {
    -webkit-line-clamp: 3;
    line-clamp: 3;
  }

  @media (max-width: 640px) {
    .card[data-shape='list'] .card__link {
      grid-template-columns: 120px 1fr;
    }

    .card[data-shape='list'] .card__title {
      font-size: var(--text-base);
    }
  }
</style>

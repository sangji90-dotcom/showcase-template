---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProductGrid from '../components/ProductGrid.astro';
import { getFeaturedProducts, getCategoriesWithCount } from '../lib/products';
import { organizationSchema } from '../lib/structured-data';

const featured = await getFeaturedProducts();
const categories = await getCategoriesWithCount();
---

<BaseLayout>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(organizationSchema())}
  />
  <Hero />

  <section class="section">
    <div class="container">
      <div class="section__head">
        <h2 class="section__title">대표 제품</h2>
        <p class="section__desc">가장 많이 찾는 제품을 모았습니다.</p>
      </div>
      <ProductGrid products={featured} />
      <div class="more">
        <a href="/products/" class="btn btn--ghost">전체 제품 보기</a>
      </div>
    </div>
  </section>

  {
    categories.length > 0 && (
      <section class="section section--subtle">
        <div class="container">
          <div class="section__head">
            <h2 class="section__title">카테고리</h2>
            <p class="section__desc">용도별로 제품을 찾아보세요.</p>
          </div>
          <div class="cats">
            {categories.map((c) => (
              <a href={`/products/category/${c.id}/`} class="cat">
                <span class="cat__label">{c.label}</span>
                <span class="cat__count">{c.count}개 제품</span>
                {c.description && <span class="cat__desc">{c.description}</span>}
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="container cta">
      <h2 class="cta__title">찾는 제품이 없으신가요?</h2>
      <p class="cta__desc">
        용도와 수량을 알려주시면 적합한 제품을 안내해 드립니다.
      </p>
      <a href="/contact/" class="btn btn--primary">문의하기</a>
    </div>
  </section>
</BaseLayout>

<style>
  .more {
    display: flex;
    justify-content: center;
    margin-top: var(--space-8);
  }

  .cats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-4);
  }

  .cat {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-6);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    transition: border-color var(--dur) var(--ease), transform var(--dur) var(--ease);
  }

  .cat:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }

  .cat__label {
    font-size: var(--text-lg);
    font-weight: 700;
  }

  .cat__count {
    font-size: var(--text-xs);
    color: var(--color-accent);
    font-weight: 600;
  }

  .cat__desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-top: var(--space-2);
  }

  .cta {
    text-align: center;
    padding: var(--space-16) var(--space-6);
    background: var(--color-bg-muted);
    border-radius: var(--radius-lg);
  }

  .cta__title {
    font-size: var(--text-2xl);
  }

  .cta__desc {
    color: var(--color-text-muted);
    margin-bottom: var(--space-6);
  }
</style>
